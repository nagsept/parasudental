    }

    .g-logo .g {
      font-size: 1.6rem;
      font-weight: 700
    }

    .g-logo .g1 {
      color: #4285F4
    }

    .g-logo .g2 {
      color: #EA4335
    }

    .g-logo .g3 {
      color: #FBBC05
    }

    .g-logo .g4 {
      color: #4285F4
    }

    .g-logo .g5 {
      color: #34A853
    }

    .stars {
      color: var(--gold);
      letter-spacing: 3px;
      font-size: 1.1rem
    }

    .t-carousel {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px
    }

    .t-card-rev {
      background: #fff;
      border-radius: var(--r-lg);
      padding: 36px;
      box-shadow: var(--shadow-sm);
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 18px
    }

    .t-card-rev .quote {
      font-family: 'Fraunces', serif;
      font-size: 3rem;
      line-height: 1;
      color: var(--gold);
      position: absolute;
      top: 22px;
      right: 30px;
      opacity: .5
    }

    .t-card-rev blockquote {
      font-size: 1rem;
      color: var(--ink);
      font-style: italic;
      flex: 1
    }

    .t-card-rev .who b {
      display: block
    }

    .t-card-rev .who small {
      color: var(--muted)
    }

    /* ---------- facilities ---------- */
    .gal {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: 200px;
      gap: 16px
    }

    .gal img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: var(--r-md);
      transition: .4s;
      cursor: default
    }

    .gal img:hover {
      transform: scale(1.02);
      box-shadow: var(--shadow)
    }

    .gal .tall {
      grid-row: span 2
    }

    .gal .wide {
      grid-column: span 2
    }

    /* ---------- location ---------- */
    .loc-grid {
      display: grid;
      grid-template-columns: 1fr 1.15fr;
      gap: 56px;
      align-items: stretch
    }

    .loc-info {
      display: flex;
      flex-direction: column;
      gap: 8px
    }

    .loc-item {
      display: flex;
      gap: 18px;
      padding: 20px 0;
      border-bottom: 1px solid var(--line)
    }

    .loc-item .li-icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
      background: var(--teal-soft);
      color: var(--teal);
      display: grid;
      place-items: center;
      flex-shrink: 0
    }

    .loc-item b {
      display: block;
      margin-bottom: 2px
    }

    .loc-item p,
    .loc-item a {
      color: var(--muted);
      font-size: .94rem
    }

    .loc-item a:hover {
      color: var(--teal)
    }

    .map-wrap {
      border-radius: var(--r-lg);
      overflow: hidden;
      box-shadow: var(--shadow);
      min-height: 420px
    }

    .map-wrap iframe {
      width: 100%;
      height: 100%;
      border: 0;
      filter: grayscale(.2)
    }

    /* ---------- appointment ---------- */
    #appointment {
      background: linear-gradient(150deg, var(--navy), var(--navy-2));
      color: #fff
    }

    #appointment .sec-head h2 {
      color: #fff
    }

    #appointment .sec-head p {
      color: rgba(255, 255, 255, .7)
    }

    #appointment .eyebrow {
      color: var(--gold)
    }

    .appt-grid {
      display: grid;
      grid-template-columns: .9fr 1.1fr;
      gap: 64px;
      align-items: start
    }

    .appt-side p {
      color: rgba(255, 255, 255, .72);
      margin-bottom: 32px;
      max-width: 400px
    }

    .appt-contact {
      display: grid;
      gap: 14px;
      margin-top: 36px
    }

    .appt-contact a {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 16px 20px;
      border-radius: var(--r-md);
      background: rgba(255, 255, 255, .06);
      border: 1px solid rgba(255, 255, 255, .12);
      font-weight: 600;
      transition: .25s;
      font-size: .95rem
    }

    .appt-contact a:hover {
      background: rgba(255, 255, 255, .12);
      transform: translateX(4px)
    }

    .appt-contact svg {
      color: var(--gold)
    }

    form.appt {
      background: #fff;
      border-radius: var(--r-lg);
      padding: 44px;
      color: var(--ink);
      box-shadow: 0 40px 90px -30px rgba(0, 0, 0, .5)
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px
    }

    .field {
      margin-bottom: 18px
    }

    .field label {
      display: block;
      font-size: .82rem;
      font-weight: 600;
      margin-bottom: 7px;
      color: var(--navy)
    }

    .field input,
    .field select,
    .field textarea {
      width: 100%;
      padding: 13px 16px;
      border: 1.5px solid var(--line);
      border-radius: 10px;
      font: inherit;
      font-size: .94rem;
      background: var(--ivory);
      transition: .25s;
      color: var(--ink)
    }

    .field input:focus,
    .field select:focus,
    .field textarea:focus {
      outline: none;
      border-color: var(--teal);
      background: #fff;
      box-shadow: 0 0 0 3px rgba(27, 122, 120, .12)
    }

    .field.error input,
    .field.error select {
      border-color: #D9534F;
      background: #FDF3F3
    }

    .err-msg {
      display: none;
      color: #D9534F;
      font-size: .78rem;
      margin-top: 5px
    }

    .field.error .err-msg {
      display: block
    }

    .form-success {
      display: none;
      background: #E8F5EE;
      border: 1px solid #BEE3CE;
      color: #1E6B45;
      padding: 16px 20px;
      border-radius: 12px;
      margin-bottom: 20px;
      font-size: .92rem;
      font-weight: 500
    }

    .form-success.show {
      display: block
    }

    form .btn {
      width: 100%;
      justify-content: center;
      margin-top: 6px
    }

    /* ---------- sticky mobile CTA ---------- */
    .mobile-cta {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 90;
      display: none;
      background: rgba(255, 255, 255, .96);
      backdrop-filter: blur(12px);
      border-top: 1px solid var(--line);
      padding: 10px 12px calc(10px + env(safe-area-inset-bottom))
    }

    .mobile-cta {
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 10px
    }

    .mobile-cta a {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
      font-size: .7rem;
      font-weight: 600;
      color: var(--navy);
      padding: 8px 4px;
      border-radius: 10px
    }

    .mobile-cta a svg {
      width: 20px;
      height: 20px
    }

    .mobile-cta a.book {
      background: var(--teal);
      color: #fff
    }

    /* ---------- footer ---------- */
    footer {
      background: var(--navy);
      color: rgba(255, 255, 255, .72);
      padding: 80px 0 0
    }

    .foot-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
      gap: 48px;
      padding-bottom: 56px
    }

    .foot-grid h4 {
      color: #fff;
      font-family: 'Inter';
      font-size: .85rem;
      letter-spacing: .1em;
      text-transform: uppercase;
      margin-bottom: 20px
    }

    .foot-grid ul {
      list-style: none;
      display: grid;
      gap: 11px;
      font-size: .92rem
    }

    .foot-grid ul a:hover {
      color: var(--gold)
    }

    .foot-brand .logo {
      margin-bottom: 16px
    }

    .foot-brand p {
      font-size: .92rem;
      max-width: 320px
    }

    .foot-bottom {
      border-top: 1px solid rgba(255, 255, 255, .12);
      padding: 26px 0;
      display: flex;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
      font-size: .82rem
    }

    .foot-bottom a:hover {
      color: var(--gold)
    }

    .socials {
      display: flex;
      gap: 12px;
      margin-top: 20px
    }

    .socials a {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      border: 1px solid rgba(255, 255, 255, .2);
      display: grid;
      place-items: center;
      transition: .25s
    }

    .socials a:hover {
      background: var(--gold);
      border-color: var(--gold);
      color: var(--navy)
    }

    /* ---------- modal ---------- */
    .modal {
      position: fixed;
      inset: 0;
      z-index: 200;
      display: none;
      place-items: center;
      background: rgba(11, 31, 51, .6);
      backdrop-filter: blur(6px);
      padding: 20px
    }

    .modal.open {
      display: grid
    }

    .modal-box {
      background: #fff;
      border-radius: var(--r-lg);
      padding: 40px;
      max-width: 440px;
      width: 100%;
      position: relative;
      text-align: center
    }

    .modal-box .close {
      position: absolute;
      top: 16px;
      right: 16px;
      background: var(--ivory);
      border: none;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      cursor: pointer;
      font-size: 1.1rem;
      color: var(--navy)
    }

    /* ---------- responsive ---------- */
    @media(max-width:1024px) {

      .hero-grid,
      .about-grid,
      .featured-grid,
      .appt-grid,
      .loc-grid {
        grid-template-columns: 1fr;
        gap: 48px
      }

      .t-grid,
      .why-grid {
        grid-template-columns: repeat(2, 1fr)
      }

      .team-grid,
      .t-carousel {
        grid-template-columns: repeat(2, 1fr)
      }

      .journey-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 40px 0
      }

      .journey-grid::before {
        display: none
      }

      .case-grid {
        grid-template-columns: repeat(2, 1fr)
      }

      .trust-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px
      }

      .foot-grid {
        grid-template-columns: 1fr 1fr
      }

      .hero-visual {
        height: 440px
      }

      .about-imgs {
        height: 420px
      }

      .featured .f-imgs {
        height: 380px
      }

      .mobile-cta {
        display: grid
      }

      body {
        padding-bottom: 74px
      }
    }

    @media(max-width:680px) {
      section {
        padding: 64px 0
      }

      .nav-links,
      .nav-phone {
        display: none
      }

      .burger {
        display: block
      }

      .nav-cta .btn {
        display: none
      }

      .t-grid,
      .why-grid,
      .team-grid,
      .t-carousel,
      .case-grid,
      .journey-grid,
      .trust-grid,
      .form-row,
      .foot-grid {
        grid-template-columns: 1fr
      }

      .gal {
        grid-template-columns: repeat(2, 1fr);
        grid-auto-rows: 160px
      }

      .g-strip {
        padding: 24px;
        text-align: center
      }

      form.appt {
        padding: 28px
      }

      .hero {
        padding-top: 120px
      }

      .hero-visual {
        height: 340px
      }

      .fc-1 {
        left: 0
      }

      .fc-2 {
        right: 0
      }

      .float-card {
        padding: 12px 14px;
        font-size: .75rem
      }
    }
  </style>
</head>

